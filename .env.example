PORT=3000
NODE_ENV=development
WEBHOOK_TOKEN=replace-with-random-secret
ADMIN_TOKEN=replace-with-admin-secret
BYDFI_API_KEY=replace-with-bydfi-api-key
BYDFI_API_SECRET=replace-with-bydfi-api-secret
BYDFI_BASE_URL=https://api.bydfi.com
BYDFI_WALLET=W001
TRADING_ENABLED=false
ALLOWED_SOURCE_IPS=
SYMBOL_MAP={"BTCUSD":"BTC-USDT"}
SYMBOL_SPECS={"BTC-USDT":{"qtyStep":0.001,"priceTick":0.1}}
SYMBOL_LEVERAGE_CAPS={"BTC-USDT":10,"SOL-USDT":5}
MAX_POSITION_SIZE={"BTC-USDT":0.1,"ETH-USDT":1,"SOL-USDT":20}
MAX_LEVERAGE=20
LEVERAGE_EXCEED_ACTION=reject
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_USDT=500
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=false
ALLOW_PYRAMIDING=false
MARGIN_MODE=isolated
BE_OFFSET_TICKS=0
MANAGER_INTERVAL_MS=10000
DEDUPE_TTL_MS=86400000
DATA_DIR=./data
DISCORD_WEBHOOK_URL=
LOG_STORE_LIMIT=200
